{
  "name": "livepeer-ui",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "sanity:login": "sanity login",
    "sanity:manage": "sanity manage",
    "sanity:schema": "sanity schema extract --path schema.json",
    "sanity:seed": "sanity exec scripts/seed-marketing-plan.mjs --with-user-token",
    "sanity:seed-registry": "sanity exec scripts/seed-registry-content.mjs --with-user-token",
    "sanity:seed-agent-flow": "sanity exec scripts/seed-agent-rollout-flow.mjs --with-user-token",
    "sanity:sync-agent-flow": "sanity exec scripts/seed-agent-rollout-flow.mjs --with-user-token -- --replace",
    "registry:build": "node scripts/build-registry.mjs && shadcn build",
    "registry:validate": "node scripts/validate-registry-docs.mjs",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@sanity/client": "^7.22.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "markdown-it": "14.3.0",
    "next": "16.2.6",
    "next-sanity": "^13.0.11",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanity": "^5.30.0",
    "shadcn": "^4.14.1",
    "shiki": "^4.3.1",
    "sonner": "^2.0.7",
    "styled-components": "^6.4.2",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/markdown-it": "14.1.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
