{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "delete-api-key-dialog",
  "title": "Delete API Key Dialog",
  "description": "Destructive API-key confirmation dialog with key metadata and warning state.",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "http://localhost:3000/r/alert-dialog.json",
    "http://localhost:3000/r/alert.json",
    "http://localhost:3000/r/button.json"
  ],
  "files": [
    {
      "path": "components/mockups/delete-api-key-dialog.tsx",
      "content": "\"use client\"\n\nimport { useState } from \"react\"\nimport { Trash2Icon, TriangleAlertIcon, XIcon } from \"lucide-react\"\n\nimport { Alert, AlertDescription, AlertTitle } from \"@/components/ui/alert\"\nimport {\n  AlertDialog,\n  AlertDialogAction,\n  AlertDialogCancel,\n  AlertDialogContent,\n  AlertDialogDescription,\n  AlertDialogFooter,\n  AlertDialogHeader,\n  AlertDialogTitle,\n  AlertDialogTrigger,\n} from \"@/components/ui/alert-dialog\"\nimport { Button } from \"@/components/ui/button\"\n\ntype DeleteApiKeyDialogProps = {\n  createdAt: string\n  name: string\n}\n\nfunction DeleteApiKeyDialog({\n  createdAt,\n  name,\n}: DeleteApiKeyDialogProps) {\n  const [open, setOpen] = useState(false)\n\n  return (\n    <AlertDialog open={open} onOpenChange={setOpen}>\n      <AlertDialogTrigger\n        render={\n          <Button\n            variant=\"ghost\"\n            size=\"icon-sm\"\n            className=\"hover:text-red-500\"\n            aria-label={`Delete ${name} API key`}\n          />\n        }\n      >\n        <Trash2Icon aria-hidden=\"true\" />\n      </AlertDialogTrigger>\n      <AlertDialogContent className=\"gap-6 rounded-sm p-6 sm:max-w-lg sm:p-8\">\n        <AlertDialogHeader className=\"flex flex-col items-start text-left!\">\n          <AlertDialogTitle className=\"w-full text-left font-sans text-2xl font-medium tracking-tight\">\n            Delete API key\n          </AlertDialogTitle>\n          <AlertDialogDescription className=\"sr-only\">\n            Permanently delete the {name} API key.\n          </AlertDialogDescription>\n        </AlertDialogHeader>\n        <AlertDialogCancel\n          variant=\"ghost\"\n          size=\"icon-sm\"\n          className=\"absolute top-4 right-4 bg-secondary\"\n        >\n          <XIcon aria-hidden=\"true\" />\n          <span className=\"sr-only\">Close</span>\n        </AlertDialogCancel>\n\n        <Alert variant=\"destructive\" className=\"rounded-sm\">\n          <TriangleAlertIcon aria-hidden=\"true\" />\n          <AlertTitle>Are you sure you want to delete this API key?</AlertTitle>\n          <AlertDescription className=\"text-muted-foreground!\">\n            This action is permanent and cannot be reversed. Any applications\n            using this key will immediately lose access to the API.\n          </AlertDescription>\n        </Alert>\n\n        <dl className=\"space-y-3 text-sm\">\n          <div className=\"grid grid-cols-[5rem_1fr] items-center gap-3\">\n            <dt className=\"text-muted-foreground\">Key name</dt>\n            <dd className=\"font-medium\">{name}</dd>\n          </div>\n          <div className=\"grid grid-cols-[5rem_1fr] items-center gap-3\">\n            <dt className=\"text-muted-foreground\">Created at</dt>\n            <dd className=\"font-medium\">{createdAt}</dd>\n          </div>\n        </dl>\n\n        <AlertDialogFooter className=\"mt-2\">\n          <AlertDialogCancel\n            variant=\"secondary\"\n            className=\"h-16 w-full shrink-0 rounded-sm px-4 sm:flex-1\"\n          >\n            Cancel\n          </AlertDialogCancel>\n          <AlertDialogAction\n            className=\"h-16 w-full shrink-0 rounded-sm bg-red-500 px-4 text-white hover:bg-red-600 sm:flex-1\"\n            onClick={() => setOpen(false)}\n          >\n            Delete key\n          </AlertDialogAction>\n        </AlertDialogFooter>\n      </AlertDialogContent>\n    </AlertDialog>\n  )\n}\n\nexport { DeleteApiKeyDialog }\n",
      "type": "registry:component"
    }
  ],
  "type": "registry:component"
}