{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "ecosystem-card",
  "title": "Ecosystem Card",
  "description": "Ecosystem application card with image, tags, description, and external action.",
  "dependencies": [
    "lucide-react",
    "next"
  ],
  "registryDependencies": [
    "https://livepeer.peaceno.de/r/badge.json"
  ],
  "files": [
    {
      "path": "components/livepeer-ui/ecosystem-card.tsx",
      "content": "import Image from \"next/image\"\nimport { ArrowUpRightIcon } from \"lucide-react\"\n\nimport { Badge } from \"@/components/ui/badge\"\n\nexport type EcosystemApp = {\n  name: string\n  domain: string\n  href: string\n  description: string\n  image: string\n  tags: string[]\n}\n\nexport function EcosystemCard({ app }: { app: EcosystemApp }) {\n  return (\n    <a\n      href={app.href}\n      target=\"_blank\"\n      rel=\"noreferrer\"\n      className=\"group flex min-h-72 flex-col rounded-sm p-6 transition-colors hover:bg-muted/50\"\n    >\n      <Image\n        src={app.image}\n        alt=\"\"\n        width={56}\n        height={56}\n        className=\"size-14 rounded-sm object-cover\"\n      />\n      <div className=\"mt-6 flex items-start justify-between gap-4\">\n        <div>\n          <h2 className=\"text-lg font-medium\">{app.name}</h2>\n          <p className=\"mt-1 font-mono text-xs text-muted-foreground\">\n            {app.domain}\n          </p>\n        </div>\n        <ArrowUpRightIcon\n          className=\"size-4 text-muted-foreground transition-colors group-hover:text-foreground\"\n          aria-hidden=\"true\"\n        />\n      </div>\n      <p className=\"mt-5 text-sm leading-relaxed text-muted-foreground\">\n        {app.description}\n      </p>\n      <div className=\"mt-auto flex flex-wrap gap-1.5 pt-6\">\n        {app.tags.map((tag) => (\n          <Badge\n            key={tag}\n            variant=\"secondary\"\n            className=\"rounded-sm font-mono text-[0.6875rem] font-normal uppercase\"\n          >\n            {tag}\n          </Badge>\n        ))}\n      </div>\n    </a>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "type": "registry:component"
}