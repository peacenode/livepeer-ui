{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "api-logs-section",
  "title": "API Logs",
  "description": "Search, error filtering, and request log table for Agent Console activity.",
  "registryDependencies": [
    "https://livepeer.peaceno.de/r/input.json",
    "https://livepeer.peaceno.de/r/label.json",
    "https://livepeer.peaceno.de/r/switch.json",
    "https://livepeer.peaceno.de/r/table.json"
  ],
  "files": [
    {
      "path": "components/mockups/api-logs-section.tsx",
      "content": "import { Input } from \"@/components/ui/input\"\nimport { Label } from \"@/components/ui/label\"\nimport { Switch } from \"@/components/ui/switch\"\nimport {\n  Table,\n  TableBody,\n  TableCell,\n  TableHead,\n  TableHeader,\n  TableRow,\n} from \"@/components/ui/table\"\n\nexport function ApiLogsSection({\n  searchPlaceholder,\n  errorsOnlyLabel,\n  emptyMessage,\n}: {\n  searchPlaceholder: string\n  errorsOnlyLabel: string\n  emptyMessage: string\n}) {\n  return (\n    <div className=\"flex flex-col gap-4\">\n      <div className=\"flex flex-col gap-3 sm:flex-row sm:items-center\">\n        <Input\n          aria-label={searchPlaceholder}\n          placeholder={searchPlaceholder}\n          className=\"max-w-sm rounded-sm\"\n        />\n        <div className=\"flex items-center gap-2\">\n          <Switch id=\"api-log-errors\" />\n          <Label htmlFor=\"api-log-errors\">{errorsOnlyLabel}</Label>\n        </div>\n      </div>\n      <Table>\n        <TableHeader>\n          <TableRow>\n            <TableHead>Method</TableHead>\n            <TableHead>Endpoint</TableHead>\n            <TableHead>Status</TableHead>\n            <TableHead>Duration</TableHead>\n            <TableHead>Time</TableHead>\n            <TableHead>API key</TableHead>\n            <TableHead>Error</TableHead>\n          </TableRow>\n        </TableHeader>\n        <TableBody>\n          <TableRow>\n            <TableCell\n              colSpan={7}\n              className=\"h-32 text-center text-muted-foreground\"\n            >\n              {emptyMessage}\n            </TableCell>\n          </TableRow>\n        </TableBody>\n      </Table>\n    </div>\n  )\n}\n",
      "type": "registry:block"
    }
  ],
  "type": "registry:block"
}