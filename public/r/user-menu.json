{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "user-menu",
  "title": "User Menu",
  "description": "Account, theme, settings, and sign-out menu used by the Agent Console sidebar.",
  "dependencies": [
    "lucide-react",
    "next",
    "next-themes"
  ],
  "registryDependencies": [
    "http://localhost:3000/r/avatar.json",
    "http://localhost:3000/r/dropdown-menu.json",
    "http://localhost:3000/r/toggle-group.json"
  ],
  "files": [
    {
      "path": "components/mockups/user-menu.tsx",
      "content": "\"use client\"\n\nimport Link from \"next/link\"\nimport {\n  BookOpenIcon,\n  CircleUserRoundIcon,\n  LifeBuoyIcon,\n  LogOutIcon,\n  MonitorIcon,\n  MoonIcon,\n  NotepadTextIcon,\n  SunIcon,\n} from \"lucide-react\"\nimport { useTheme } from \"next-themes\"\n\nimport { Avatar, AvatarFallback } from \"@/components/ui/avatar\"\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuItem,\n  DropdownMenuSeparator,\n  DropdownMenuTrigger,\n} from \"@/components/ui/dropdown-menu\"\nimport { ToggleGroup, ToggleGroupItem } from \"@/components/ui/toggle-group\"\n\nconst themes = [\n  { value: \"system\", label: \"System theme\", icon: MonitorIcon },\n  { value: \"light\", label: \"Light theme\", icon: SunIcon },\n  { value: \"dark\", label: \"Dark theme\", icon: MoonIcon },\n]\n\nexport function UserMenu() {\n  const { theme, setTheme } = useTheme()\n\n  return (\n    <DropdownMenu>\n      <DropdownMenuTrigger\n        render={\n          <button className=\"flex w-full items-center gap-3 rounded-sm px-2 py-2 text-left transition-colors outline-none hover:bg-muted focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 aria-expanded:bg-muted\" />\n        }\n      >\n        <Avatar className=\"size-9\">\n          <AvatarFallback className=\"bg-foreground text-background\">\n            P\n          </AvatarFallback>\n        </Avatar>\n        <div className=\"flex flex-col text-sm leading-tight\">\n          <span className=\"font-medium\">Username</span>\n          <span className=\"text-muted-foreground\">Account</span>\n        </div>\n      </DropdownMenuTrigger>\n      <DropdownMenuContent side=\"top\" sideOffset={8} className=\"w-60\">\n        <div className=\"flex flex-col gap-2 px-2 pt-1.5 pb-2\">\n          <span className=\"truncate text-sm text-muted-foreground\">\n            username@example.com\n          </span>\n          <ToggleGroup\n            value={[theme ?? \"system\"]}\n            onValueChange={(value) => {\n              if (value[0]) setTheme(value[0])\n            }}\n            className=\"rounded-lg bg-muted p-0.5\"\n          >\n            {themes.map(({ value, label, icon: Icon }) => (\n              <ToggleGroupItem\n                key={value}\n                value={value}\n                size=\"sm\"\n                aria-label={label}\n                className=\"flex-1 data-[state=on]:bg-background data-[state=on]:shadow-xs\"\n              >\n                <Icon />\n              </ToggleGroupItem>\n            ))}\n          </ToggleGroup>\n        </div>\n        <DropdownMenuSeparator />\n        <DropdownMenuItem render={<Link href=\"/mockups/livepeer-agent/account\" />}>\n          <CircleUserRoundIcon />\n          Manage profile\n        </DropdownMenuItem>\n        <DropdownMenuSeparator />\n        <DropdownMenuItem>\n          <BookOpenIcon />\n          Developer docs\n        </DropdownMenuItem>\n        <DropdownMenuItem>\n          <NotepadTextIcon />\n          Terms &amp; policies\n        </DropdownMenuItem>\n        <DropdownMenuItem>\n          <LifeBuoyIcon />\n          Help\n        </DropdownMenuItem>\n        <DropdownMenuSeparator />\n        <DropdownMenuItem>\n          <LogOutIcon />\n          Log out\n        </DropdownMenuItem>\n      </DropdownMenuContent>\n    </DropdownMenu>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "type": "registry:component"
}