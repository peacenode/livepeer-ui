{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "usage-workspace-section",
  "title": "Usage Workspace",
  "description": "Complete overview and activity workspace composed from reusable usage components.",
  "dependencies": [
    "lucide-react",
    "next"
  ],
  "registryDependencies": [
    "http://localhost:3000/r/badge.json",
    "http://localhost:3000/r/button.json",
    "http://localhost:3000/r/card.json",
    "http://localhost:3000/r/table.json",
    "http://localhost:3000/r/tabs.json"
  ],
  "files": [
    {
      "path": "components/mockups/usage-workspace.tsx",
      "content": "import { CreditBalance } from \"@/components/mockups/credit-balance\"\nimport { DailyUsageTable } from \"@/components/mockups/daily-usage-table\"\nimport { LivepeerAgentBillingCards } from \"@/components/mockups/livepeer-agent-billing-cards\"\nimport { LivepeerAgentPromoCards } from \"@/components/mockups/livepeer-agent-promo-cards\"\nimport { ResourceUsageTable } from \"@/components/mockups/resource-usage-table\"\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from \"@/components/ui/tabs\"\n\nexport function UsageWorkspace() {\n  return (\n    <Tabs defaultValue=\"overview\" className=\"gap-8\">\n      <TabsList variant=\"line\" className=\"w-full justify-start overflow-x-auto border-b px-0 pb-1\">\n        <TabsTrigger value=\"overview\" className=\"flex-none\">Overview</TabsTrigger>\n        <TabsTrigger value=\"activity\" className=\"flex-none\">Activity</TabsTrigger>\n      </TabsList>\n      <TabsContent value=\"overview\"><div className=\"flex flex-col gap-10\">\n        <CreditBalance />\n        <section>\n          <h2 className=\"font-sans text-2xl font-medium tracking-tight\">Get more credits</h2>\n          <p className=\"mt-2 max-w-2xl text-sm leading-relaxed text-muted-foreground\">\n            Upgrade for a larger credit allocation that refreshes every month.\n          </p>\n          <div className=\"mt-6\"><LivepeerAgentPromoCards /></div>\n        </section>\n      </div></TabsContent>\n      <TabsContent value=\"activity\"><div className=\"flex flex-col gap-10\">\n        <section><LivepeerAgentBillingCards /></section>\n        <DailyUsageTable />\n        <ResourceUsageTable />\n      </div></TabsContent>\n    </Tabs>\n  )\n}\n",
      "type": "registry:block"
    },
    {
      "path": "components/mockups/credit-balance.tsx",
      "content": "import { Badge } from \"@/components/ui/badge\"\n\nexport function CreditBalance() {\n  return (\n    <section className=\"grid gap-4 md:grid-cols-2\">\n      <div className=\"flex flex-col gap-8\">\n        <div className=\"flex items-center gap-2\">\n          <h2 className=\"font-sans text-sm font-medium\">Credit balance</h2>\n          <Badge variant=\"outline\">Free</Badge>\n        </div>\n        <div>\n          <p className=\"text-5xl leading-none font-medium tracking-tight tabular-nums sm:text-6xl\">\n            32{\" \"}\n            <span className=\"text-xl font-normal tracking-normal text-muted-foreground sm:text-2xl\">\n              / 50 credits\n            </span>\n          </p>\n          <div className=\"mt-8 flex items-center gap-2\">\n            <span className=\"text-sm text-muted-foreground\">Credits refresh</span>\n            <Badge variant=\"secondary\" className=\"rounded-sm\">Aug 1, 2026</Badge>\n          </div>\n        </div>\n      </div>\n    </section>\n  )\n}\n",
      "type": "registry:block"
    },
    {
      "path": "components/mockups/daily-usage-table.tsx",
      "content": "import {\n  Table, TableBody, TableCell, TableHead, TableHeader, TableRow,\n} from \"@/components/ui/table\"\n\nconst dailyUsage = [\n  { date: \"Jul 23\", workflowRuns: \"182.4K\", compute: \"284 GPU min\", credits: \"24.8\" },\n  { date: \"Jul 22\", workflowRuns: \"168.1K\", compute: \"261 GPU min\", credits: \"22.4\" },\n  { date: \"Jul 21\", workflowRuns: \"155.7K\", compute: \"249 GPU min\", credits: \"21.1\" },\n  { date: \"Jul 20\", workflowRuns: \"149.2K\", compute: \"238 GPU min\", credits: \"19.7\" },\n]\n\nexport function DailyUsageTable() {\n  return (\n    <section className=\"flex flex-col gap-3\">\n      <h2 className=\"font-sans text-sm font-medium\">Daily usage</h2>\n      <Table>\n        <TableHeader><TableRow>\n          <TableHead>Date</TableHead><TableHead>Workflow runs</TableHead>\n          <TableHead>Compute</TableHead><TableHead className=\"text-right\">Credits</TableHead>\n        </TableRow></TableHeader>\n        <TableBody>{dailyUsage.map((day) => (\n          <TableRow key={day.date}>\n            <TableCell className=\"font-medium\">{day.date}</TableCell>\n            <TableCell className=\"font-sans text-xs tabular-nums\">{day.workflowRuns}</TableCell>\n            <TableCell className=\"font-sans text-xs tabular-nums\">{day.compute}</TableCell>\n            <TableCell className=\"text-right font-sans text-xs tabular-nums\">{day.credits}</TableCell>\n          </TableRow>\n        ))}</TableBody>\n      </Table>\n    </section>\n  )\n}\n",
      "type": "registry:block"
    },
    {
      "path": "components/mockups/livepeer-agent-billing-cards.tsx",
      "content": "import {\n  Card,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\"\n\nexport function LivepeerAgentBillingCards() {\n  return (\n    <div className=\"grid gap-3 sm:grid-cols-2\">\n      <Card variant=\"metric\">\n        <CardHeader>\n          <CardDescription>Workflow runs</CardDescription>\n          <CardTitle className=\"font-sans text-3xl leading-none font-medium tracking-tight tabular-nums\">\n            1.2M\n          </CardTitle>\n        </CardHeader>\n      </Card>\n      <Card variant=\"metric\">\n        <CardHeader>\n          <CardDescription>Compute time</CardDescription>\n          <CardTitle className=\"font-sans text-3xl leading-none font-medium tracking-tight tabular-nums\">\n            2,431 GPU min\n          </CardTitle>\n        </CardHeader>\n      </Card>\n    </div>\n  )\n}\n",
      "type": "registry:block"
    },
    {
      "path": "components/mockups/livepeer-agent-promo-cards.tsx",
      "content": "import Link from \"next/link\"\nimport { ArrowRightIcon } from \"lucide-react\"\n\nimport { Badge } from \"@/components/ui/badge\"\nimport { Button } from \"@/components/ui/button\"\n\nexport function LivepeerAgentPromoCards() {\n  return (\n    <div className=\"grid gap-4 md:grid-cols-2\">\n      <div className=\"flex min-h-64 flex-col rounded-sm border p-6\">\n        <p className=\"text-sm font-medium text-muted-foreground\">Pro</p>\n        <p className=\"mt-5 text-4xl font-medium tracking-tight tabular-nums\">\n          500{\" \"}\n          <span className=\"text-lg font-normal text-muted-foreground\">\n            credits/mo\n          </span>\n        </p>\n        <p className=\"mt-4 text-sm text-muted-foreground\">\n          For regular creative sessions and production workflows.\n        </p>\n        <Button\n          variant=\"outline\"\n          size=\"lg\"\n          nativeButton={false}\n          render={\n            <Link href=\"/mockups/livepeer-agent/organization?tab=billing\" />\n          }\n          className=\"mt-auto h-16 w-full rounded-sm px-4\"\n        >\n          Subscribe to Pro\n          <ArrowRightIcon aria-hidden=\"true\" />\n        </Button>\n      </div>\n      <div className=\"relative flex min-h-64 flex-col rounded-sm border border-emerald-500 p-6\">\n        <Badge className=\"absolute top-0 right-6 -translate-y-1/2 bg-emerald-500 text-white\">\n          Recommended\n        </Badge>\n        <p className=\"text-sm font-medium text-emerald-700\">Max</p>\n        <p className=\"mt-5 text-4xl font-medium tracking-tight tabular-nums\">\n          1,750{\" \"}\n          <span className=\"text-lg font-normal text-muted-foreground\">\n            credits/mo\n          </span>\n        </p>\n        <p className=\"mt-4 text-sm text-muted-foreground\">\n          For teams that generate and iterate throughout the week.\n        </p>\n        <Button\n          size=\"lg\"\n          variant=\"secondary\"\n          nativeButton={false}\n          render={\n            <Link href=\"/mockups/livepeer-agent/organization?tab=billing\" />\n          }\n          className=\"mt-auto h-16 w-full rounded-sm border border-emerald-500 bg-emerald-500 px-4 text-white hover:bg-emerald-500\"\n          style={{\n            backgroundImage:\n              \"linear-gradient(160deg, color(display-p3 0.04 0.74 0.49) 0%, color(display-p3 0.04 0.74 0.49) 32%, color(display-p3 0.02 0.58 0.36) 100%)\",\n          }}\n        >\n          Subscribe to Max\n          <ArrowRightIcon aria-hidden=\"true\" />\n        </Button>\n      </div>\n    </div>\n  )\n}\n",
      "type": "registry:block"
    },
    {
      "path": "components/mockups/resource-usage-table.tsx",
      "content": "import {\n  Table, TableBody, TableCell, TableHead, TableHeader, TableRow,\n} from \"@/components/ui/table\"\n\nconst resourceUsage = [\n  { resource: \"text-to-image\", type: \"Workflow\", usage: \"612.8K requests\", credits: \"86.4\" },\n  { resource: \"live-video-to-video\", type: \"Workflow\", usage: \"396.1K requests\", credits: \"64.8\" },\n  { resource: \"us-east\", type: \"Compute\", usage: \"1,188 GPU min\", credits: \"48.8\" },\n]\n\nexport function ResourceUsageTable() {\n  return (\n    <section className=\"flex flex-col gap-3\">\n      <h2 className=\"font-sans text-sm font-medium\">Usage by resource</h2>\n      <Table>\n        <TableHeader><TableRow>\n          <TableHead>Resource</TableHead><TableHead>Type</TableHead>\n          <TableHead>Usage</TableHead><TableHead className=\"text-right\">Credits</TableHead>\n        </TableRow></TableHeader>\n        <TableBody>{resourceUsage.map((resource) => (\n          <TableRow key={resource.resource}>\n            <TableCell className=\"font-mono text-xs font-medium\">{resource.resource}</TableCell>\n            <TableCell>{resource.type}</TableCell>\n            <TableCell className=\"font-sans text-xs tabular-nums\">{resource.usage}</TableCell>\n            <TableCell className=\"text-right font-sans text-xs tabular-nums\">{resource.credits}</TableCell>\n          </TableRow>\n        ))}</TableBody>\n      </Table>\n    </section>\n  )\n}\n",
      "type": "registry:block"
    }
  ],
  "type": "registry:block"
}